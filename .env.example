# Copy to .env.local and fill in the values you need. Never commit real keys.

# Site
NEXT_PUBLIC_APP_URL=http://localhost:3000   # base URL used for SEO, metadata and emails
NEXT_PUBLIC_GA_ID=                          # Google Analytics measurement ID (optional)
GOOGLE_SITE_VERIFICATION=                   # Google Search Console verification token (optional)
INDEXNOW_KEY=                               # IndexNow key used by `npm run seo:index`

# "Ask Whizzly AI" chat (src/app/api/chat/route.ts)
# Providers are tried in order: Groq, then Gemini, then OpenAI.
# With no key set, the chat answers with its built-in fallback replies.
GROQ_API_KEY=                               # GROQ_KEY is also accepted
GEMINI_API_KEY=                             # GOOGLE_AI_API_KEY or GOOGLE_API_KEY are also accepted
OPENAI_API_KEY=
TAVILY_API_KEY=                             # web search for the chat's RAG (src/lib/rag/web.ts)

# Client portal (src/lib/portal)
DATABASE_URL=                               # Postgres connection string
PORTAL_SESSION_SECRET=                      # long random string for signing sessions
PORTAL_SETUP_CODE=                          # one-time code to create the first admin account

# Portal email via Gmail API (src/lib/portal/mail.ts)
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
